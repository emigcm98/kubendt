{
  "add_dns_nameserver": {
    "executor": "kubectl",
    "commands": [
      ["sh","-c","grep -q '^nameserver 8.8.8.8$' /etc/resolv.conf || echo 'nameserver 8.8.8.8' | tee -a /etc/resolv.conf \u003e /dev/null"]
    ]
  },
  "add_dns_search": {
    "executor": "kubectl",
    "commands": [
      ["sh","-c","if grep -q '^search ' /etc/resolv.conf; then grep -q '^search .* lab.local' /etc/resolv.conf || (cat /etc/resolv.conf | sed 's/^search .*/\u0026 lab.local/' | tee /etc/resolv.conf \u003e /dev/null); else echo 'search lab.local' | tee -a /etc/resolv.conf \u003e /dev/null; fi"]
    ]
  },
  "add_interface_to_bridge": { "unsupported": true },
  "add_qdisc": {
    "executor": "tc_universal",
    "commands": [
      ["tc","qdisc","replace","dev","eth1","root","noqueue"],
      ["tc","qdisc","replace","dev","eth1","root","netem","delay","50ms","5ms","loss","1%","rate","10mbit"]
    ]
  },
  "add_static_route": {
    "executor": "kubectl",
    "commands": [
      ["ip","route","replace","10.1.0.0/16","via","10.0.0.254","dev","eth1"]
    ]
  },
  "custom": {
    "executor": "kubectl",
    "commands": [
      ["sh","-c","echo hello"]
    ]
  },
  "del_qdisc": {
    "executor": "tc_universal",
    "commands": [
      ["tc","qdisc","replace","dev","eth1","root","noqueue"],
      ["tc","qdisc","del","dev","eth1","root"]
    ]
  },
  "disable_dnat": { "unsupported": true },
  "disable_snat": { "unsupported": true },
  "enable_dnat": { "unsupported": true },
  "enable_snat": { "unsupported": true },
  "link_down": {
    "executor": "kubectl",
    "commands": [
      ["ip","link","set","eth1","down"]
    ]
  },
  "link_up": {
    "executor": "kubectl",
    "commands": [
      ["ip","link","set","eth1","up"]
    ]
  },
  "ospf6_add_interface": { "unsupported": true },
  "ospf6_originate_default": { "unsupported": true },
  "ospf6_passive_interface": { "unsupported": true },
  "ospf6_redistribute": { "unsupported": true },
  "ospf6_remove_interface": { "unsupported": true },
  "ospf6_remove_originate_default": { "unsupported": true },
  "ospf6_remove_passive_interface": { "unsupported": true },
  "ospf6_remove_redistribute": { "unsupported": true },
  "ospf6_remove_router_id": { "unsupported": true },
  "ospf6_set_router_id": { "unsupported": true },
  "ospf_add_network": { "unsupported": true },
  "ospf_mtu_ignore": { "unsupported": true },
  "ospf_no_passive": { "unsupported": true },
  "ospf_originate_default": { "unsupported": true },
  "ospf_passive_default": { "unsupported": true },
  "ospf_redistribute": { "unsupported": true },
  "ospf_remove_mtu_ignore": { "unsupported": true },
  "ospf_remove_network": { "unsupported": true },
  "ospf_remove_no_passive": { "unsupported": true },
  "ospf_remove_originate_default": { "unsupported": true },
  "ospf_remove_passive_default": { "unsupported": true },
  "ospf_remove_redistribute": { "unsupported": true },
  "ospf_remove_router_id": { "unsupported": true },
  "ospf_set_router_id": { "unsupported": true },
  "remove_default_route": {
    "executor": "kubectl",
    "commands": [
      ["ip","route","del","default"]
    ]
  },
  "remove_dns_nameserver": {
    "executor": "kubectl",
    "commands": [
      ["sh","-c","cat /etc/resolv.conf | grep -v '^nameserver 8.8.8.8$' | tee /etc/resolv.conf \u003e /dev/null"]
    ]
  },
  "remove_dns_search": {
    "executor": "kubectl",
    "commands": [
      ["sh","-c","cat /etc/resolv.conf | sed 's/^search \\(.*\\) lab.local /search \\1 /' | sed 's/^search \\(.*\\) lab.local$/search \\1/' | sed 's/ *$//' | tee /etc/resolv.conf \u003e /dev/null"]
    ]
  },
  "remove_interface_from_bridge": { "unsupported": true },
  "remove_ip": {
    "executor": "kubectl",
    "commands": [
      ["sh","-c","! ip -o addr show dev eth1 | grep -qF ' 10.0.0.1/24 ' || ip addr del 10.0.0.1/24 dev eth1"]
    ]
  },
  "remove_static_route": {
    "executor": "kubectl",
    "commands": [
      ["ip","route","del","10.1.0.0/16","via","10.0.0.254","dev","eth1"]
    ]
  },
  "replace_ip": {
    "executor": "kubectl",
    "commands": [
      ["sh","-c","ip -o addr show dev eth1 | grep -q ' 10.0.0.1/24 ' || { ip addr flush dev eth1; ip addr add 10.0.0.1/24 dev eth1; }"]
    ]
  },
  "rip_add_network": { "unsupported": true },
  "rip_passive_interface": { "unsupported": true },
  "rip_redistribute": { "unsupported": true },
  "rip_remove_network": { "unsupported": true },
  "rip_remove_passive_interface": { "unsupported": true },
  "rip_remove_redistribute": { "unsupported": true },
  "rip_remove_timers": { "unsupported": true },
  "rip_set_timers": { "unsupported": true },
  "set_default_route": {
    "executor": "kubectl",
    "commands": [
      ["ip","route","replace","default","via","10.0.0.254"]
    ]
  },
  "set_ip": {
    "executor": "kubectl",
    "commands": [
      ["ip","addr","replace","10.0.0.1/24","dev","eth1"]
    ]
  },
  "setup_bridge": { "unsupported": true },
  "teardown_bridge": { "unsupported": true }
}

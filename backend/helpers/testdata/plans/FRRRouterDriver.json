  "nat64_disable": {
    "executor": "kubectl",
    "commands": [
      ["sh","-c","pkill -9 -x tayga 2\u003e/dev/null; tayga --rmtun -c /etc/tayga.conf 2\u003e/dev/null; ip link del nat64 2\u003e/dev/null; rm -f /etc/tayga.conf; true"]

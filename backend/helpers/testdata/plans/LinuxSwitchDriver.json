  "set_datapath_id": { "unsupported": true },
  "set_default_route": {
    "executor": "kubectl",
    "commands": [
      ["ip","route","replace","default","via","10.0.0.254"]
    ]
  },
  "set_dns": {
    "executor": "kubectl",
    "commands": [
      ["sh","-c","[ -f /etc/resolv.conf.kubendt ] || cp /etc/resolv.conf /etc/resolv.conf.kubendt; printf 'nameserver 10.0.0.53\\nnameserver 10.0.0.54\\nsearch lab.local\\n' \u003e /etc/resolv.conf"]
    ]
  },
  "set_fail_mode": { "unsupported": true },
  "set_ip": {
    "executor": "kubectl",
    "commands": [
      ["ip","addr","replace","10.0.0.1/24","dev","eth1"]
    ]
  },
  "set_mac": {
    "executor": "kubectl",
    "commands": [
      ["ip","link","set","eth1","address","08:00:00:00:01:11"]
    ]
  },
  "setup_bridge": {
    "executor": "kubectl",
    "commands": [
      ["sh","-c","ip link show br0 || ip link add br0 type bridge"],
      ["ip","link","set","br0","up"],
      ["ip","link","set","eth1","master","br0"],
      ["ip","link","set","eth2","master","br0"]
    ]
  },
  "stp_disable": {
    "executor": "kubectl",
    "commands": [
      ["sh","-c","ip link set br0 type bridge stp_state 0 \u0026\u0026 for p in /sys/class/net/br0/brif/*; do [ -e \"$p\" ] || continue; [ \"$(cat \"$p/state\")\" = 3 ] || { d=${p##*/}; ip link set dev \"$d\" down \u0026\u0026 ip link set dev \"$d\" up; }; done; true"]
    ]
  },
  "stp_enable": {
    "executor": "kubectl",
    "commands": [
      ["ip","link","set","br0","type","bridge","stp_state","1"]
    ]
  },
  "stp_set_bridge_priority": {
    "executor": "kubectl",
    "commands": [
      ["ip","link","set","br0","type","bridge","priority","4096"]
    ]
  },
  "stp_set_port": {
    "executor": "kubectl",
    "commands": [
      ["bridge","link","set","dev","eth1","cost","50","priority","64"]
    ]
  },
  "table_add": { "unsupported": true },
  "table_delete": { "unsupported": true },
  "table_set_default": { "unsupported": true },
  "teardown_bridge": {
    "executor": "kubectl",
    "commands": [
      ["ip","link","set","br0","down"],
      ["ip","link","del","br0","type","bridge"]
    ]
  },
  "vlan_clear_port": {
    "executor": "kubectl",
    "commands": [
      ["sh","-c","if [ -d /sys/class/net/eth1/bridge ]; then b=eth1; s=self; else b=$(ip link show eth1 | sed -n 's/.* master \\([^ ]*\\).*/\\1/p' | head -1); s=; fi; [ -n \"$b\" ] \u0026\u0026 ip link set \"$b\" type bridge vlan_filtering 1; bridge vlan del dev eth1 vid 1-4094 $s; bridge vlan add dev eth1 vid 1 pvid untagged $s"]
    ]
  },
  "vlan_set_access": {
    "executor": "kubectl",
    "commands": [
      ["sh","-c","if [ -d /sys/class/net/eth1/bridge ]; then b=eth1; s=self; else b=$(ip link show eth1 | sed -n 's/.* master \\([^ ]*\\).*/\\1/p' | head -1); s=; fi; [ -n \"$b\" ] \u0026\u0026 ip link set \"$b\" type bridge vlan_filtering 1; bridge vlan del dev eth1 vid 1-4094 $s; bridge vlan add dev eth1 vid 10 pvid untagged $s"]
    ]
  },
  "vlan_set_trunk": {
    "executor": "kubectl",
    "commands": [
      ["sh","-c","if [ -d /sys/class/net/eth1/bridge ]; then b=eth1; s=self; else b=$(ip link show eth1 | sed -n 's/.* master \\([^ ]*\\).*/\\1/p' | head -1); s=; fi; [ -n \"$b\" ] \u0026\u0026 ip link set \"$b\" type bridge vlan_filtering 1; bridge vlan del dev eth1 vid 1-4094 $s; bridge vlan add dev eth1 vid 10 $s; bridge vlan add dev eth1 vid 20 $s; bridge vlan add dev eth1 vid 99 pvid untagged $s"]
    ]
  }
}

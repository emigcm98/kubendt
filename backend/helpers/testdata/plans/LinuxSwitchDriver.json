  "remove_dns_nameserver": {
    "executor": "kubectl",
    "commands": [
      ["sh","-c","c=$(grep -v '^nameserver 8.8.8.8$' /etc/resolv.conf); printf '%s\\n' \"$c\" \u003e /etc/resolv.conf"]
    ]
  },
  "remove_dns_search": {
    "executor": "kubectl",
    "commands": [
      ["sh","-c","c=$(sed 's/^search \\(.*\\) lab.local /search \\1 /' /etc/resolv.conf | sed 's/^search \\(.*\\) lab.local$/search \\1/' | sed 's/ *$//'); printf '%s\\n' \"$c\" \u003e /etc/resolv.conf"]
    ]
  },
  "remove_interface_from_bridge": {
    "executor": "kubectl",
    "commands": [
      ["ip","link","set","eth1","nomaster"]
    ]
  },
  "remove_ip": {
    "executor": "kubectl",
    "commands": [
      ["sh","-c","! ip -o addr show dev eth1 | grep -qF ' 10.0.0.1/24 ' || ip addr del 10.0.0.1/24 dev eth1"]
    ]
  },
  "remove_multicast_group": { "unsupported": true },
  "remove_static_neighbor": {
    "executor": "kubectl",
    "commands": [

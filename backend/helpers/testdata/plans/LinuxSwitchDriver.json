{
  "add_dns_nameserver": {
    "executor": "kubectl",
    "commands": [
      ["sh","-c","grep -q '^nameserver 8.8.8.8$' /etc/resolv.conf || echo 'nameserver 8.8.8.8' | tee -a /etc/resolv.conf \u003e /dev/null"]
    ]
  },
  "add_dns_search": {
    "executor": "kubectl",
    "commands": [
      ["sh","-c","if grep -q '^search ' /etc/resolv.conf; then grep -q '^search .* lab.local' /etc/resolv.conf || { c=$(sed 's/^search .*/\u0026 lab.local/' /etc/resolv.conf); printf '%s\\n' \"$c\" \u003e /etc/resolv.conf; }; else echo 'search lab.local' | tee -a /etc/resolv.conf \u003e /dev/null; fi"]
    ]
  },
  "add_flow": { "unsupported": true },
  "add_interface_to_bridge": {
    "executor": "kubectl",
    "commands": [
      ["ip","link","set","eth1","master","br0"]
    ]
  },
  "add_multicast_group": { "unsupported": true },
  "add_qdisc": {
    "executor": "tc_universal",
    "commands": [
      ["tc","qdisc","replace","dev","eth1","root","noqueue"],
      ["tc","qdisc","replace","dev","eth1","root","netem","delay","50ms","5ms","loss","1%","rate","10mbit"]
    ]
  },
  "add_static_neighbor": {
    "executor": "kubectl",
    "commands": [
      ["ip","neigh","replace","10.0.1.254","lladdr","08:00:00:00:00:fe","dev","eth1","nud","permanent"]
    ]
  },
  "add_static_route": {
    "executor": "kubectl",
    "commands": [
      ["ip","route","replace","10.1.0.0/16","via","10.0.0.254","dev","eth1"]
    ]
  },
  "add_vlan_subinterface": {
    "executor": "kubectl",
    "commands": [
      ["sh","-c","ip link show eth1.10 \u003e/dev/null 2\u003e\u00261 || ip link add link eth1 name eth1.10 type vlan id 10"],
      ["ip","link","set","eth1.10","up"],
      ["ip","addr","replace","10.0.10.1/24","dev","eth1.10"]
    ]
  },

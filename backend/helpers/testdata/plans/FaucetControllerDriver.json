  "bgp_set_router": { "unsupported": true },
  "clear_dns": {
    "executor": "kubectl",
    "commands": [
      ["sh","-c","if [ -f /etc/resolv.conf.kubendt ]; then cat /etc/resolv.conf.kubendt \u003e /etc/resolv.conf; fi"]
    ]
  },
  "controller_apply_config": {
    "executor": "kubectl",
    "commands": [
      ["sh","-c","printf '%s\\n' 'vlans:\n  office:\n    vid: 10\n' \u003e /etc/faucet/faucet.yaml \u0026\u0026 kill -HUP 1"]
    ]
  },
  "custom": {
    "executor": "kubectl",
    "commands": [
      ["sh","-c","echo hello"]
    ]
  },
  "del_qdisc": {
    "executor": "tc_universal",

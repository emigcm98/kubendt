{
  "nodes": [
    {
      "name": "user",
      "image": "alpine",
      "type": "host",
      "driver": "HostDriver",
      "replicas": 4,
      "commands": [
        "sh",
        "-c",
        "apk add iproute2-tc && sleep infinity"
      ],
      "env": {
        "HOST_VAR": "soy una variable de entorno compartida entre todas las replicas"
      }
    },
    {
      "name": "web-public",
      "image": "nginx:alpine",
      "type": "host",
      "mounts": [
        {
          "file": "web_public/index_public.html",
          "mountTo": "/usr/share/nginx/html/index.html"
        }
      ]
    },
    {
      "name": "web-internal",
      "image": "nginx:alpine",
      "type": "host",
      "mounts": [
        {
          "file": "web_internal/index_internal.html",
          "mountTo": "/usr/share/nginx/html/index.html"
        }
      ]
    },
    {
      "name": "dns-server",
      "image": "internetsystemsconsortium/bind9:9.18",
      "type": "host",
      "commands": [
        "sh",
        "-c",
        "set -e; mkdir -p /tmp/bind; named -g -c /etc/bind/named.conf"
      ],
      "mounts": [
        {
          "file": "dns/named.conf",
          "mountTo": "/etc/bind/named.conf"
        },
        {
          "file": "dns/named.conf.options",
          "mountTo": "/etc/bind/named.conf.options"
        },
        {
          "file": "dns/named.conf.local",
          "mountTo": "/etc/bind/named.conf.local"
        },
        {
          "file": "dns/db.kubendt.local",
          "mountTo": "/etc/bind/db.kubendt.local"
        }
      ]
    },
    {
      "name": "iperf-server",
      "image": "networkstatic/iperf3",
      "type": "host",
      "replicas": 2,
      "commands": [
        "sh",
        "-c",
        "apt update && apt install -y iproute2 iputils-ping && iperf3 -s -p 5201"
      ]
    },
    {
      "name": "edge-router",
      "image": "frrouting/frr",
      "type": "router",
      "driver": "FRRRouterDriver",
      "commands": [
        "sh",
        "-c",
        "echo hostname edge-router > /etc/frr/vtysh.conf && chown frr:frr /etc/frr/vtysh.conf && /usr/lib/frr/zebra -d && /usr/lib/frr/ospfd -d && sleep infinity"
      ]
    },
    {
      "name": "room-router",
      "image": "frrouting/frr",
      "type": "router",
      "driver": "FRRRouterDriver",
      "commands": [
        "sh",
        "-c",
        "echo hostname room-router > /etc/frr/vtysh.conf && chown frr:frr /etc/frr/vtysh.conf && /usr/lib/frr/zebra -d && /usr/lib/frr/ospfd -d && sleep infinity"
      ]
    },
    {
      "name": "svc-router",
      "image": "frrouting/frr",
      "type": "router",
      "driver": "FRRRouterDriver",
      "commands": [
        "sh",
        "-c",
        "echo hostname svc-router > /etc/frr/vtysh.conf && chown frr:frr /etc/frr/vtysh.conf && /usr/lib/frr/zebra -d && /usr/lib/frr/ospfd -d && sleep infinity"
      ]
    },
    {
      "name": "core-sw",
      "image": "globocom/openvswitch",
      "type": "switch",
      "commands": [
        "sh",
        "-c",
        "apk update && apk add --no-cache iproute2 iputils && ovsdb-server --remote=punix:/var/run/openvswitch/db.sock --remote=db:Open_vSwitch,Open_vSwitch,manager_options --pidfile --detach && ovs-vswitchd --pidfile --detach && tail -f /dev/null"
      ]
    },
    {
      "name": "dist-sw",
      "image": "globocom/openvswitch",
      "type": "switch",
      "commands": [
        "sh",
        "-c",
        "apk update && apk add --no-cache iproute2 iputils && ovsdb-server --remote=punix:/var/run/openvswitch/db.sock --remote=db:Open_vSwitch,Open_vSwitch,manager_options --pidfile --detach && ovs-vswitchd --pidfile --detach && tail -f /dev/null"
      ]
    },
    {
      "name": "dmz-sw",
      "image": "ubuntu",
      "type": "switch",
      "commands": [
        "sh",
        "-c",
        "apt update && apt install -y iproute2 bridge-utils iputils-ping && sleep infinity"
      ]
    },
    {
      "name": "svc-sw",
      "image": "ubuntu",
      "type": "switch",
      "commands": [
        "sh",
        "-c",
        "apt update && apt install -y iproute2 bridge-utils iputils-ping && sleep infinity"
      ]
    },
    {
      "name": "room-sw",
      "replicas": 2,
      "image": "ubuntu",
      "type": "switch",
      "commands": [
        "sh",
        "-c",
        "apt update && apt install -y iproute2 bridge-utils iputils-ping && sleep infinity"
      ]
    }
  ],

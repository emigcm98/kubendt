{
  "nodes": [
    {
      "name": "user",
      "image": "alpine:3.24.2",
      "type": "host",
      "driver": "HostDriver",
      "replicas": 4,
      "env": {
        "HOST_VAR": "soy una variable de entorno compartida entre todas las replicas"
      }
    },
    {
      "name": "web-public",
      "image": "nginx:1.31.6-alpine",
      "type": "host",
      "mounts": [
        {
          "file": "web_public/index_public.html",
          "mountTo": "/usr/share/nginx/html/index.html"
        }
      ]
    },
    {
      "name": "web-internal",
      "image": "nginx:1.31.6-alpine",
      "type": "host",
      "mounts": [
        {
          "file": "web_internal/index_internal.html",
          "mountTo": "/usr/share/nginx/html/index.html"
        }
      ]
    },
    {
      "name": "dns-server",
      "image": "internetsystemsconsortium/bind9:9.20",
      "type": "host",
      "commands": [
        "sh",
        "-c",
        "set -e; mkdir -p /tmp/bind; named -g -c /etc/bind/named.conf"
      ],
      "mounts": [
        {
          "file": "dns/named.conf",
          "mountTo": "/etc/bind/named.conf"
        },
        {
          "file": "dns/named.conf.options",
          "mountTo": "/etc/bind/named.conf.options"
        },
        {
          "file": "dns/named.conf.local",
          "mountTo": "/etc/bind/named.conf.local"
        },
        {
          "file": "dns/db.kubendt.local",
          "mountTo": "/etc/bind/db.kubendt.local"
        }
      ]
    },
    {
      "name": "iperf-server",
      "image": "networkstatic/iperf3:latest",
      "type": "host",
      "replicas": 2,
      "commands": [
        "iperf3",
        "-s",
        "-p",
        "5201"
      ]
    },
    {
      "name": "edge-router",
      "image": "quay.io/frrouting/frr:10.7.1",
      "type": "router",
      "driver": "FRRRouterDriver"
    },
    {
      "name": "room-router",
      "image": "quay.io/frrouting/frr:10.7.1",
      "type": "router",
      "driver": "FRRRouterDriver"
    },
    {
      "name": "svc-router",
      "image": "quay.io/frrouting/frr:10.7.1",
      "type": "router",
      "driver": "FRRRouterDriver"
    },
    {
      "name": "core-sw",
      "image": "globocom/openvswitch:latest",
      "type": "switch",
      "driver": "OpenVSwitchDriver"
    },
    {
      "name": "dist-sw",
      "image": "globocom/openvswitch:latest",
      "type": "switch",
      "driver": "OpenVSwitchDriver"
    },
    {
      "name": "dmz-sw",
      "image": "alpine:3.24.2",
      "type": "switch"
    },
    {
      "name": "svc-sw",
      "image": "alpine:3.24.2",
      "type": "switch"
    },
    {
      "name": "room-sw",
      "replicas": 2,
      "image": "alpine:3.24.2",
      "type": "switch"
    }
  ],
  "links": [
    {
      "node": "edge-router",
      "localIntf": "eth1",
      "localIp": "",
      "peerNode": "external",
      "peerIntf": "ens18",
      "peerIp": "",
      "peerLabel": "External Network"
    },
    {
      "node": "edge-router",
      "localIntf": "eth2",
      "localIp": "10.0.255.254/24",
      "peerNode": "core-sw",
      "peerIntf": "eth1",
      "peerIp": ""
    },
    {
      "node": "core-sw",
      "localIntf": "eth2",
      "localIp": "",
      "peerNode": "dist-sw",
      "peerIntf": "eth1",
      "peerIp": ""
    },
    {
      "node": "core-sw",
      "localIntf": "eth3",
      "localIp": "",
      "peerNode": "dmz-sw",
      "peerIntf": "eth1",
      "peerIp": ""
    },
    {
      "node": "dmz-sw",
      "localIntf": "eth2",
      "localIp": "",
      "peerNode": "web-public",
      "peerIntf": "eth1",
      "peerIp": "10.0.255.20/24"
    },
    {
      "node": "dmz-sw",
      "localIntf": "eth3",
      "localIp": "",
      "peerNode": "iperf-server-0",
      "peerIntf": "eth1",
      "peerIp": "10.0.255.10/24"
    },
    {
      "node": "dist-sw",
      "localIntf": "eth2",
      "localIp": "",
      "peerNode": "svc-router",
      "peerIntf": "eth1",
      "peerIp": "10.0.255.253/24"
    },
    {
      "node": "dist-sw",
      "localIntf": "eth3",
      "localIp": "",
      "peerNode": "room-router",
      "peerIntf": "eth1",
      "peerIp": "10.0.255.252/24",
      "delay": "10ms",
      "bandwidth": "50mbit"
    },
    {
      "node": "svc-router",
      "localIntf": "eth2",
      "localIp": "192.168.10.1/24",
      "peerNode": "svc-sw",
      "peerIntf": "eth1",
      "peerIp": ""
    },
    {
      "node": "svc-sw",
      "localIntf": "eth2",
      "localIp": "",
      "peerNode": "iperf-server-1",
      "peerIntf": "eth1",
      "peerIp": "192.168.10.10/24"
    },
    {
      "node": "svc-sw",
      "localIntf": "eth3",
      "localIp": "",
      "peerNode": "dns-server",
      "peerIntf": "eth1",
      "peerIp": "192.168.10.15/24"
    },
    {
      "node": "svc-sw",
      "localIntf": "eth4",
      "localIp": "",
      "peerNode": "web-internal",
      "peerIntf": "eth1",
      "peerIp": "192.168.10.20/24"
    },
    {
      "node": "room-router",
      "localIntf": "eth2",
      "localIp": "192.168.0.1/24",
      "peerNode": "room-sw-0",
      "peerIntf": "eth1",
      "peerIp": ""
    },
    {
      "node": "room-router",
      "localIntf": "eth3",
      "localIp": "192.168.1.1/24",
      "peerNode": "room-sw-1",
      "peerIntf": "eth1",
      "peerIp": ""
    },
    {
      "node": "room-sw-0",
      "localIntf": "eth2",
      "localIp": "",
      "peerNode": "user-0",
      "peerIntf": "eth1",
      "peerIp": "192.168.0.10/24"
    },
    {
      "node": "room-sw-0",
      "localIntf": "eth3",
      "localIp": "",
      "peerNode": "user-1",
      "peerIntf": "eth1",
      "peerIp": "192.168.0.11/24"
    },
    {
      "node": "room-sw-1",
      "localIntf": "eth2",
      "localIp": "",
      "peerNode": "user-2",
      "peerIntf": "eth1",
      "peerIp": "192.168.1.10/24"
    },
    {
      "node": "room-sw-1",
      "localIntf": "eth3",
      "localIp": "",
      "peerNode": "user-3",
      "peerIntf": "eth1",
      "peerIp": "192.168.1.11/24"
    }
  ]
}

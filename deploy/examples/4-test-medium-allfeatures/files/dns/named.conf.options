options {
  directory "/tmp/bind";

  listen-on { 127.0.0.1; 192.168.10.15; };
  listen-on-v6 { none; };

  allow-query { any; };

  recursion yes;
  allow-recursion { 192.168.0.0/24; 192.168.1.0/24; 192.168.10.0/24; 10.0.255.0/24; };

  dnssec-validation no;

  // forwarders { 1.1.1.1; 8.8.8.8; };
};
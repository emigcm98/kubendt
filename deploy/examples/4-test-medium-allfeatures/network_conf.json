{
  "targets": [
    {
      "pod": "edge-router-0",
      "actions": [
        {
          "type": "replace_ip",
          "iface": "eth1",
          "cidr": "10.208.11.100/16"
        },
        {
          "type": "enable_snat",
          "iface": "eth0"
        },
        {
          "type": "enable_dnat",
          "iface": "eth1",
          "externalPort": 5201,
          "internalIP": "10.0.255.10",
          "internalPort": 5201,
          "protocol": "tcp"
        },
        {
          "type": "enable_dnat",
          "iface": "eth1",
          "externalPort": 5201,
          "internalIP": "10.0.255.10",
          "internalPort": 5201,
          "protocol": "udp"
        },
        {
          "type": "enable_dnat",
          "iface": "eth1",
          "externalPort": 80,
          "internalIP": "10.0.255.20",
          "internalPort": 80,
          "protocol": "tcp"
        },
        { "type": "ospf_set_router_id", "router_id": "10.0.255.254" },
        { "type": "ospf_passive_default" },
        { "type": "ospf_no_passive", "iface": "eth2" },
        { "type": "ospf_add_network", "cidr": "10.0.255.0/24", "ospf_area": "0" },
        { "type": "ospf_originate_default" },
        { "type": "ospf_mtu_ignore", "iface": "eth2" }
      ]
    },
    {
      "pod": "svc-router-0",
      "actions": [
        {
          "type": "remove_default_route"
        },
        { "type": "ospf_set_router_id", "router_id": "10.0.255.253" },
        { "type": "ospf_passive_default" },
        { "type": "ospf_no_passive", "iface": "eth1" },
        { "type": "ospf_add_network", "cidr": "10.0.255.0/24", "ospf_area": "0" },
        { "type": "ospf_add_network", "cidr": "192.168.10.0/24", "ospf_area": "0" },
        { "type": "ospf_mtu_ignore", "iface": "eth1" }
      ]
    },
    {
      "pod": "room-router-0",
      "actions": [
        {
          "type": "remove_default_route"
        },
        { "type": "ospf_set_router_id", "router_id": "10.0.255.252" },
        { "type": "ospf_passive_default" },
        { "type": "ospf_no_passive", "iface": "eth1" },
        { "type": "ospf_add_network", "cidr": "10.0.255.0/24", "ospf_area": "0" },
        { "type": "ospf_add_network", "cidr": "192.168.0.0/24", "ospf_area": "0" },
        { "type": "ospf_add_network", "cidr": "192.168.1.0/24", "ospf_area": "0" },
        { "type": "ospf_mtu_ignore", "iface": "eth1" }
      ]
    },
    {

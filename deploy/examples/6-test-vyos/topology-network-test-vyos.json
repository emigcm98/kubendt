{
  "nodes": [
    {
      "name": "host",
      "image": "alpine",
      "type": "host",
      "driver": "BasicHostDriver",
      "replicas": 4,
      "commands": [
        "sh",
        "-c",
        "apk update && apk add iproute2 && sleep infinity"
      ]
    },
    {
      "name": "router",
      "image": "localhost/vyos-router:dev",
      "type": "router",
      "driver": "VyOSRouterDriver",
      "replicas": 2
    },
    {
      "name": "web-server",
      "image": "nginx:alpine",
      "type": "host",
      "mounts": [
        {
          "file": "web-server/index.html",
          "mountTo": "/usr/share/nginx/html/index.html"
        }
      ]
    }
  ],
  "links": [
    {
      "node": "router-0",
      "localIntf": "eth4",
      "localIp": "",
      "peerNode": "external",
      "peerIntf": "ens18",
      "peerIp": "",
      "peerLabel": "External Network"
    },
    {
      "localIntf": "eth1",
      "node": "host-0",
      "peerNode": "router-0",
      "peerIntf": "eth2",
      "localIp": "10.0.0.10/24",
      "peerIp": "10.0.0.1/24"
    },
    {
      "localIntf": "eth1",
      "node": "host-1",
      "peerNode": "router-0",
      "peerIntf": "eth3",
      "localIp": "10.0.1.10/24",
      "peerIp": "10.0.1.1/24"
    },
    {
      "localIntf": "eth1",
      "node": "router-0",
      "peerNode": "router-1",
      "peerIntf": "eth1",
      "localIp": "10.0.10.1/30",
      "peerIp": "10.0.10.2/30"
    },
    {
      "localIntf": "eth1",
      "node": "host-2",
      "peerNode": "router-1",
      "peerIntf": "eth2",
      "localIp": "10.0.2.10/24",
      "peerIp": "10.0.2.1/24"
    },
    {
      "localIntf": "eth1",
      "node": "host-3",
      "peerNode": "router-1",
      "peerIntf": "eth3",
      "localIp": "10.0.3.10/24",
      "peerIp": "10.0.3.1/24"
    },
    {
      "localIntf": "eth1",
      "node": "web-server",
      "peerNode": "router-1",
      "peerIntf": "eth4",
      "localIp": "10.0.4.10/24",
      "peerIp": "10.0.4.1/24"
    }
  ]
}
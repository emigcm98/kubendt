{
    "nodes": [
        {
            "name": "pc",
            "image": "alpine:3.24.2",
            "type": "host",
            "replicas": 4,
            "env": {
                "ENV1": "I don't know why",
                "ENV2": "to cry"
            },
            "mounts": [
                {
                    "file": "test.sh",
                    "mountTo": "/mnt/test.sh"
                }
            ]
        },
        {
            "name": "server",
            "image": "alpine:3.24.2",
            "type": "host",
            "driver": "HostDriver",
            "replicas": 1,
            "mounts": [
                {
                    "file": "secret.env",
                    "mountTo": "/etc/kubendt/secret.env",
                    "sensitive": true
                }
            ]
        },
        {
            "name": "r1",

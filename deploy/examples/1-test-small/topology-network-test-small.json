{
  "nodes": [
    {
      "name": "pc",
      "image": "alpine",
      "type": "host",
      "replicas": 4,
      "commands": [
        "sh",
        "-c",
        "apk update && apk add iproute2 && sleep infinity"
      ],
      "env": {
        "ENV1": "I don't know why",
        "ENV2": "to cry"
      },
      "mounts": [
        {
          "file": "test.sh",
          "mountTo": "/mnt/test.sh"
        }
      ]
    },
    {
      "name": "server",
      "image": "alpine",
      "type": "host",
      "driver": "BasicHostDriver",
      "replicas": 1,
      "commands": [
        "sh",
        "-c",
        "apk update && apk add iproute2 && sleep infinity"
      ],
      "mounts": [
        {
          "file": "secret.env",
          "mountTo": "/etc/kubendt/secret.env",
          "sensitive": true
        }
      ]
    },
    {
      "name": "r1",
      "image": "frrouting/frr",
      "type": "router",
      "driver": "FRRRouterDriver",
      "commands": [
        "sh",
        "-c",
        "echo hostname r1 > /etc/frr/vtysh.conf && chown frr:frr /etc/frr/vtysh.conf && /usr/lib/frr/zebra -d && /usr/lib/frr/ospfd -d && sleep infinity"
      ]
    },
    {
      "name": "sw",
      "image": "ubuntu",
      "type": "switch",
      "replicas": 2,
      "commands": [
        "sh",
        "-c",
        "apt update && apt install -y iproute2 bridge-utils iputils-ping && sleep infinity"
      ]
    },
    {
      "name": "ovs",
      "image": "globocom/openvswitch",
      "driver" : "OpenVSwitchDriver",
      "type": "switch",
      "replicas": 1,
      "commands": [
        "sh",
        "-c",
        "apk update && apk add --no-cache iproute2 iputils && ovsdb-server --remote=punix:/var/run/openvswitch/db.sock --remote=db:Open_vSwitch,Open_vSwitch,manager_options --pidfile --detach && ovs-vswitchd --pidfile --detach && tail -f /dev/null"
      ]
    }
  ],
  "links": [
    {
      "localIntf": "eth1",
      "node": "pc-0",
      "peerNode": "sw-0",
      "peerIntf": "eth1",
      "uid": 3188142,
      "localIp": "10.0.1.11/24",
      "peerIp": ""
    },
    {

{
  "nodes": [
    {
      "name": "ubuntu-host",
      "image": "ubuntu:26.04",
      "type": "host",
      "driver": "HostDriver",
      "commands": [
        "sh",
        "-c",
        "apt update && apt install -y iproute2 iputils-ping && sleep infinity"
      ],
      "readiness": [
        "sh",
        "-c",
        "command -v ping"
      ]
    },
    {
      "name": "alpine-host",
      "image": "alpine:3.24.2",
      "type": "host",
      "driver": "BasicHostDriver"
    },
    {
      "name": "switch",
      "image": "globocom/openvswitch:latest",
      "type": "switch",
      "driver": "OpenVSwitchDriver",
      "replicas": 2
    },
    {
      "name": "frr-router",
      "image": "quay.io/frrouting/frr:10.7.1",
      "type": "router",
      "driver": "FRRRouterDriver"
    },
    {
      "name": "vyos-router",
      "image": "localhost/vyos-router:dev",
      "type": "router",
      "driver": "VyOSRouterDriver"
    }
  ],
  "links": [
    {
      "localIntf": "eth1",
      "node": "ubuntu-host",
      "peerNode": "switch-0",
      "peerIntf": "eth2",
      "localIp": "10.0.1.11/24",
      "peerIp": ""
    },
    {
      "localIntf": "eth1",
      "node": "frr-router",
      "peerNode": "switch-0",
      "peerIntf": "eth1",
      "localIp": "10.0.1.1/24",
      "peerIp": ""
    },
    {
      "localIntf": "eth1",
      "node": "alpine-host",
      "peerNode": "switch-1",
      "peerIntf": "eth2",
      "localIp": "10.0.2.11/24",
      "peerIp": ""
    },
    {
      "localIntf": "eth1",
      "node": "vyos-router",
      "peerNode": "switch-1",
      "peerIntf": "eth1",
      "localIp": "10.0.2.1/24",
      "peerIp": ""
    },
    {
      "localIntf": "eth2",
      "node": "frr-router",
      "peerNode": "vyos-router",
      "peerIntf": "eth2",
      "localIp": "10.0.254.1/30",
      "peerIp": "10.0.254.2/30"
    }
  ]
}
